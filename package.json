{
  "name": "mil-symbol-converter",
  "version": "0.7.0",
  "description": "Convert MIL-STD-2525C letter SIDCs to MIL-STD-2525D/E and APP-6D/E numeric SIDCs and back; draw incomplete codes from real data, catch typos in codes you write.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "bin": {
    "mil-symbol-converter": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-exports": "node scripts/verify-exports.mjs",
    "build-data": "node scripts/build-data.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify-exports",
    "prepare": "tsup",
    "site": "vite site",
    "build:site": "vite build site --base ./ --outDir ../site-dist --emptyOutDir"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orbat-mapper/convert-symbology": "^1.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.2",
    "milsymbol": "^3.0.4",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lansenou/Mil-Symbol-Converter.git"
  },
  "homepage": "https://github.com/Lansenou/Mil-Symbol-Converter#readme",
  "bugs": {
    "url": "https://github.com/Lansenou/Mil-Symbol-Converter/issues"
  },
  "keywords": [
    "mil-std-2525",
    "app-6",
    "sidc",
    "military-symbology",
    "milsymbol",
    "2525c",
    "2525d",
    "2525e"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
