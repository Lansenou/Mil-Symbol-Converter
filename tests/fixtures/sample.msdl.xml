<?xml version="1.0" encoding="UTF-8"?>
<!-- Small hand-written MSDL scenario for tests (not taken from the standard). -->
<MilitaryScenario xmlns="urn:sisostds:scenario:military:data:draft:msdl:1">
  <ForceSides>
